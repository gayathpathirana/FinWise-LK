<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1220"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FinWise LK"
            android:textColor="#F4C542"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Smart Personal Finance"
            android:textColor="#AAB4C5"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome to FinWise!"
            android:textColor="#FFFFFF"
            android:textSize="23sp"
            android:textStyle="bold"
            android:layout_marginTop="30dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Make smarter financial decisions."
            android:textColor="#AAB4C5"
            android:textSize="14sp"
            android:layout_marginTop="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#18263B"
            android:padding="20dp"
            android:layout_marginTop="25dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YOUR FINANCIAL COMPANION"
                android:textColor="#AAB4C5"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Plan. Compare. Grow."
                android:textColor="#F4C542"
                android:textSize="23sp"
                android:textStyle="bold"
                android:layout_marginTop="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Take control of your financial future with FinWise LK."
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:layout_marginTop="8dp" />

        </LinearLayout>

        <!-- User Welcome Message -->

        <TextView
            android:id="@+id/tvUserWelcome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Welcome, User!"
            android:textColor="#F4C542"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="22dp"
            android:visibility="gone" />

        <!-- Create Account Button -->

        <Button
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="CREATE ACCOUNT"
            android:textColor="#0B1220"
            android:textStyle="bold"
            android:backgroundTint="#F4C542"
            android:layout_marginTop="22dp" />

        <!-- Login Button -->

        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="LOGIN"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#263750"
            android:layout_marginTop="12dp" />

        <!-- Logout Button -->

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="LOG OUT"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#9B3030"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Financial Services"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="15dp" />

        <Button
            android:id="@+id/btnFD"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Fixed Deposit Comparison"
            android:textColor="#0B1220"
            android:textStyle="bold"
            android:backgroundTint="#F4C542" />

        <Button
            android:id="@+id/btnLoan"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Loan Comparison"
            android:layout_marginTop="12dp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#263750" />

        <Button
            android:id="@+id/btnSalary"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Salary &amp; Tax Calculator"
            android:layout_marginTop="12dp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#263750" />

        <Button
            android:id="@+id/btnInvestment"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Investment Calculator"
            android:layout_marginTop="12dp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#263750" />

        <Button
            android:id="@+id/btnGoals"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Financial Goal Planner"
            android:layout_marginTop="12dp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#263750" />

    </LinearLayout>

</ScrollView>
